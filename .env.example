# ===== ViVideoYouTube — пример конфигурации =====
# Скопируйте этот файл в ".env" и заполните своими значениями:
#   cp .env.example .env
# Реальные ключи получаются в Google Cloud Console → APIs & Services → Credentials.

# API Key (для публичных query-запросов к YouTube Data API)
API_KEY=ВАШ_API_KEY

# OAuth2 Client ID / Client Secret (для загрузки видео от имени пользователя)
CLIENT_ID=ВАШ_CLIENT_ID
CLIENT_SECRET=ВАШ_CLIENT_SECRET

# Путь к JSON-файлу с OAuth-клиентскими данными (installed app)
CLIENT_SECRET_FILE=client_secret_ВАШ_ИД_КЛИЕНТА.json

# Файл, куда будет сохранён refresh-токен после первой OAuth-авторизации
OAUTH_TOKEN_FILE=token.json

# Скоупы для YouTube Data API
YOUTUBE_SCOPES=openid,https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.force-ssl,https://www.googleapis.com/auth/youtube.readonly

# Категория по умолчанию для видео / шортсов
# 0 = Unspecified, 22 = People & Blogs
DEFAULT_CATEGORY_ID=22
